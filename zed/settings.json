// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "diff_view_style": "unified",
  "git_panel": {
    "dock": "left",
    "tree_view": true,
  },
  "icon_theme": {
    "mode": "light",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "edit_predictions": {
    "provider": "none",
  },
  "agent_servers": {
    "amp-acp": {
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
    },
  },
  "agent": {
    "dock": "right",
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4",
    },
  },
  "vim_mode": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "theme": {
    "mode": "light",
    "light": "One Light",
    "dark": "One Dark",
  },
  "languages": {
    "Nix": {
      "language_servers": ["nixd", "nil"],
    },
    "TOML": {
      "language_servers": ["taplo"],
    },
  },
  "lsp": {
    // Specify the LSP name as a key here.
    "rust-analyzer": {
      // These initialization options are merged into Zed's defaults
      "initialization_options": {
        "check": {
          "command": "clippy", // rust-analyzer.check.command (default: "check")
        },
      },
    },
    "nixd": {
      "binary": {
        "path": "nixd",
      },

      "settings": {
        "formatting": {
          "command": ["alejandra"],
        },
      },
    },
    "nil": {
      "binary": {
        "path": "nil",
      },
    },
    "hls": {
      "settings": {
        "haskell": {
          "formattingProvider": "fourmolu",
        },
      },
    },
  },
  // Add extensions here (don't install it via Zed's UI).
  //
  // Correct name of extensions matters!
  // Always use the `id` of the extension defined in its `extension.toml`
  // Extensions will be installed into `~/.local/share/zed/extensions/installed`
  // https://zed.dev/docs/configuring-zed#auto-install-extensions
  "auto_install_extensions": {
    "astro": true,
    "elm": true,
    "git-firefly": true,
    "haskell": true,
    "html": true,
    "lean4": true,
    "just": true,
    "nix": true,
    "svelte": true,
    "oxc": true,
    "sql": true,
    "toml": true,
    "tree-sitter-query": true,
    "vue": true,
    "zig": true,
  },
}
